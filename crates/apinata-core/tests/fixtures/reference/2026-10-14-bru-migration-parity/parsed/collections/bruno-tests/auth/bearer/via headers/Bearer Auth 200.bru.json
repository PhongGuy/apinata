{
  "meta": {
    "name": "Bearer Auth 200",
    "type": "http",
    "seq": "1"
  },
  "http": {
    "method": "get",
    "url": "{{host}}/api/auth/bearer/protected",
    "body": "json",
    "auth": "none"
  },
  "headers": [
    {
      "name": "Authorization",
      "value": "Bearer {{bearer_auth_token}}",
      "enabled": true
    }
  ],
  "vars": {
    "req": [
      {
        "name": "a-c",
        "value": "foo",
        "enabled": true,
        "local": false
      }
    ]
  },
  "assertions": [
    {
      "name": "res.status",
      "value": "200",
      "enabled": true
    },
    {
      "name": "res.body.message",
      "value": "Authentication successful",
      "enabled": true
    }
  ],
  "script": {
    "res": "bru.setEnvVar(\"foo\", \"bar\");"
  }
}
