{
  "meta": {
    "name": "echo numbers",
    "type": "http",
    "seq": "1"
  },
  "http": {
    "method": "post",
    "url": "{{echo-host}}",
    "body": "json",
    "auth": "none"
  },
  "body": {
    "json": "{\n  \"integer\": 123,\n  \"negativeInteger\": -99,\n  \"zero\": 0,\n  \"float\": 2.718,\n  \"negativeFloat\": -1.618,\n  \"largeDouble\": 12345.678901234567,\n  \"smallDouble\": 9.876e-12,\n  \"booleanTrue\": true,\n  \"booleanFalse\": false\n}"
  },
  "assertions": [
    {
      "name": "res.body.integer",
      "value": "eq 123",
      "enabled": true
    },
    {
      "name": "res.body.integer",
      "value": "isNumber",
      "enabled": true
    },
    {
      "name": "res.body.negativeInteger",
      "value": "eq -99",
      "enabled": true
    },
    {
      "name": "res.body.negativeInteger",
      "value": "isNumber",
      "enabled": true
    },
    {
      "name": "res.body.zero",
      "value": "eq 0",
      "enabled": true
    },
    {
      "name": "res.body.zero",
      "value": "isNumber",
      "enabled": true
    },
    {
      "name": "res.body.float",
      "value": "eq 2.718",
      "enabled": true
    },
    {
      "name": "res.body.float",
      "value": "isNumber",
      "enabled": true
    },
    {
      "name": "res.body.negativeFloat",
      "value": "eq -1.618",
      "enabled": true
    },
    {
      "name": "res.body.negativeFloat",
      "value": "isNumber",
      "enabled": true
    },
    {
      "name": "res.body.largeDouble",
      "value": "eq 12345.678901234567",
      "enabled": true
    },
    {
      "name": "res.body.largeDouble",
      "value": "isNumber",
      "enabled": true
    },
    {
      "name": "res.body.smallDouble",
      "value": "eq 9.876e-12",
      "enabled": true
    },
    {
      "name": "res.body.smallDouble",
      "value": "isNumber",
      "enabled": true
    },
    {
      "name": "res.body.booleanTrue",
      "value": "eq true",
      "enabled": true
    },
    {
      "name": "res.body.booleanFalse",
      "value": "eq false",
      "enabled": true
    }
  ]
}
