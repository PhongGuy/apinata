{
  "meta": {
    "name": "mutation",
    "type": "graphql",
    "seq": "3"
  },
  "http": {
    "method": "post",
    "url": "{{localhost}}/api/graphql",
    "body": "graphql",
    "auth": "inherit"
  },
  "body": {
    "graphql": {
      "query": "mutation create($id: String!) {\n  create(payload: { id: $id }) {\n    success\n  }\n}\n",
      "variables": "{\n  \"id\":\"1\"\n}"
    }
  },
  "assertions": [
    {
      "name": "res.status",
      "value": "eq 200",
      "enabled": true
    },
    {
      "name": "res.body.data.create.success",
      "value": "eq true",
      "enabled": true
    }
  ],
  "settings": {
    "encodeUrl": true,
    "timeout": 0
  }
}
