{
  "meta": {
    "name": "Duplicate Keys",
    "type": "http",
    "seq": "1"
  },
  "http": {
    "method": "post",
    "url": "https://echo.usebruno.com",
    "body": "formUrlEncoded",
    "auth": "none"
  },
  "headers": [
    {
      "name": "Content-Type",
      "value": "application/x-www-form-urlencoded",
      "enabled": true
    }
  ],
  "body": {
    "formUrlEncoded": [
      {
        "name": "tags",
        "value": "frontend",
        "enabled": true
      },
      {
        "name": "tags",
        "value": "api",
        "enabled": true
      },
      {
        "name": "user",
        "value": "john",
        "enabled": true
      }
    ]
  },
  "script": {
    "res": "test('Response body matches expected value', function () {\n    expect(res.getBody()).to.eql(\"tags=frontend&tags=api&user=john\");\n});"
  }
}
