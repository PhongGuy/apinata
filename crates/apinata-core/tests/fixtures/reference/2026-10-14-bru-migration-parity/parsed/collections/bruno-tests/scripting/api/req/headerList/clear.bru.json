{
  "meta": {
    "name": "clear",
    "type": "http",
    "seq": "7"
  },
  "http": {
    "method": "get",
    "url": "{{host}}/ping",
    "body": "none",
    "auth": "none"
  },
  "headers": [
    {
      "name": "bruno",
      "value": "is-awesome",
      "enabled": true
    },
    {
      "name": "della",
      "value": "is-beautiful",
      "enabled": true
    }
  ],
  "assertions": [
    {
      "name": "res.status",
      "value": "eq 200",
      "enabled": true
    },
    {
      "name": "res.body",
      "value": "eq pong",
      "enabled": true
    }
  ],
  "script": {
    "req": "req.headerList.clear();"
  },
  "tests": "test(\"req.headerList.clear() removes user-defined headers\", function() {\n  expect(req.headerList.has('bruno')).to.be.false;\n  expect(req.headerList.has('della')).to.be.false;\n  expect(req.getHeaders()['bruno']).to.be.undefined;\n  expect(req.getHeaders()['della']).to.be.undefined;\n});"
}
