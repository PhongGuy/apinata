get {
  url: https://example.com
  auth: oauth2
}

auth:oauth2 {
  grant_type: password
  access_token_url: https://example.com/token
  refresh_token_url: https://example.com/refresh
  username: alice
  password: secret
  client_id: cid
  client_secret: csecret
  scope: read write
  credentials_placement: basic_auth_header
  credentials_id: creds
  token_placement: url
  token_header_prefix: Bearer
  token_query_key: tok
  auto_fetch_token: true
  auto_refresh_token: true
}
