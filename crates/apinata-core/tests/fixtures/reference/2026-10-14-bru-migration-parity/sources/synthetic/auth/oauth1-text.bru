get {
  url: https://example.com
  auth: oauth1
}

auth:oauth1 {
  consumer_key: ck
  consumer_secret: cs
  access_token: at
  token_secret: ts
  callback_url: https://example.com/cb
  verifier: v
  signature_method: HMAC-SHA1
  private_key: plain-key
  timestamp: 
  nonce: n
  version: 1.0
  realm: r
  placement: header
  include_body_hash: false
}
