# Net::HTTP does not follow redirects; this prints the first response.
require "net/http"

uri = URI("http://x.test/p?x=a%27b$c%7Bd%7D&y=%C3%BC")
request = Net::HTTP::Post.new(uri)
request["X-H"] = "it's \"q\" \\ $HOME {x} ü"
request["content-type"] = "text/plain"
request.body = "a'b\"c\\d $e {f}\tg\nü€ end"

response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == "https") do |http|
  http.request(request)
end
puts response.code
puts response.body
