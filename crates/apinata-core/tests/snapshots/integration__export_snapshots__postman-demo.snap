{
  "info": {
    "name": "Apinata Demo",
    "description": "# Apinata Demo\n\nA small tour of Apinata.\n\n- **Posts** and **Users** call [JSONPlaceholder](https://jsonplaceholder.typicode.com), a free fake REST API.\n- **Media** calls [httpbin](https://httpbin.org) for responses that are not JSON.\n- **Auth** shows digest, NTLM, AWS Sig v4 signing and an OAuth 1.0 signature httpbin echoes.\n- **GraphQL** calls [GraphQLZero](https://graphqlzero.almansi.me), JSONPlaceholder's data over GraphQL.\n\nMedia, Auth and GraphQL call other sites, so they are tagged `manual` and Run collection leaves them unticked; tick them to include them. The SigV4 example only shows signing, so its made-up address never answers.\n\nSending a request needs network access.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Posts",
      "item": [
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/posts?_limit=5",
              "protocol": "",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "_limit",
                  "value": "5"
                }
              ],
              "variable": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "// Assertions",
                  "pm.test(\"res.status eq 200\", () => pm.expect(pm.response.code).to.equal(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get post",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Fetches the post named by the `postId` collection variable and keeps its title as `postTitle`.",
            "url": {
              "raw": "{{baseUrl}}/posts/:id",
              "protocol": "",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                ":id"
              ],
              "query": [],
              "variable": [
                {
                  "key": "id",
                  "value": "{{postId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "// Assertions",
                  "pm.test(\"res.status eq 200\", () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test(\"res.body.id eq 1\", () => pm.expect(pm.response.json().id).to.equal(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "description": "",
                "disabled": false,
                "type": "default"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/posts",
              "protocol": "",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello from Apinata\",\n  \"body\": \"A demo post.\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "// Assertions",
                  "pm.test(\"res.status eq 201\", () => pm.expect(pm.response.code).to.equal(201));"
                ]
