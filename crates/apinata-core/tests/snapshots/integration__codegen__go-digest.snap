// Digest auth is not included in this snippet.

package main

import (
	"fmt"
	"io"
	"net/http"
)

func main() {
	url := "http://x.test/digest"
	req, err := http.NewRequest("GET", url, nil)
	if err != nil {
		panic(err)
	}

	res, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer res.Body.Close()
	out, err := io.ReadAll(res.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(res.Status)
	fmt.Println(string(out))
}
