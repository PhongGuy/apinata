<?php

$curl = curl_init();
curl_setopt_array($curl, [
    CURLOPT_URL => "http://x.test/a?q=1&r=two",
    CURLOPT_CUSTOMREQUEST => "GET",
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_HTTPHEADER => [
        "X-A: 2",
        "Cookie: b=2",
    ],
]);

$response = curl_exec($curl);
echo curl_getinfo($curl, CURLINFO_RESPONSE_CODE), "\n";
echo $response, "\n";
