== opencollection.yml
opencollection: 1.0.0

info:
  name: Multiple child collections with authorization, headers and variables set at each level

request:
  headers:
    - name: Custom-Header
      value: Custom header value set at the root collection
    - name: Inherited-Header
      value: Inherited header at all levels
  auth:
    type: basic
    username: testuser
    password: testpass
  variables:
    - name: collection-variable
      value: collection-variable-value
bundled: false
extensions:
  bruno:
    ignore:
      - node_modules
      - .git
