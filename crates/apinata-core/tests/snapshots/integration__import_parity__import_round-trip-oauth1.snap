  type: http
  seq: 1

http:
  method: GET
  url: http://localhost:3000/health
  auth:
    type: oauth1
    consumerKey: key
    consumerSecret: "{{type_1_consumer_secret}}"
    accessToken: "{{type_1_access_token}}"
    accessTokenSecret: "{{type_1_access_token_secret}}"
    callbackUrl: url
