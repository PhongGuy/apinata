=== pets/Create a pet.yml
info:
  name: Create a pet
  type: http
  seq: 2
  tags:
    - pets

http:
  method: POST
  url: "{{baseUrl}}/pets"
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

=== pets/Info for a specific pet.yml
info:
  name: Info for a specific pet
  type: http
  seq: 3
  tags:
    - pets

http:
  method: GET
  url: "{{baseUrl}}/pets/:petId"
  params:
    - name: petId
      value: ""
      type: path
      description: The id of the pet to retrieve
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

=== pets/List all pets.yml
info:
  name: List all pets
  type: http
  seq: 1
  tags:
    - pets

http:
  method: GET
  url: "{{baseUrl}}/pets"
  params:
    - name: limit
      value: ""
      type: query
      description: How many items to return at one time (max 100)
      disabled: true
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
