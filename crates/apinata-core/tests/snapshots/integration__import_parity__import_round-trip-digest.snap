== Own auth.yml
info:
  name: Own auth
  type: http
  seq: 1

http:
  method: GET
  url: http://localhost:3000/health
  auth:
    type: digest
    username: test
    password: "{{own_auth_password}}"

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
== environments/Environment.yml
name: Environment
variables:
  - secret: true
    name: own_auth_password
== opencollection.yml
opencollection: 1.0.0

info:
  name: Digest

request:
  auth:
    type: digest
    username: username
    password: "{{password}}"
bundled: false
extensions:
  bruno:
    ignore:
      - node_modules
      - .git
    presets:
      defaultEnvironment: Environment
