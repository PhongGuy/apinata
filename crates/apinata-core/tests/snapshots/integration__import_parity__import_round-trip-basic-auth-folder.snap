== opencollection.yml
opencollection: 1.0.0

info:
  name: Basic Auth

request:
  auth:
    type: basic
    username: john
    password: "{{basic_auth_password}}"
bundled: false
extensions:
  bruno:
    ignore:
      - node_modules
      - .git
    presets:
      defaultEnvironment: Environment
