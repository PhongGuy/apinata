---
source: crates/apinata-core/tests/export_html_corpus.rs
expression: rendered(&out)
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:">
<title>Inheritance YML</title>
<style>
:root {
  color-scheme: light dark;
  --bg: #ffffff;
  --fg: #1f2328;
  --muted: #59636e;
  --line: #d1d9e0;
  --panel: #f6f8fa;
  --link: #0969da;
  --get: #1a7f37;
  --post: #9a6700;
  --put: #0969da;
  --patch: #8250df;
  --delete: #cf222e;
  --head: #1b7c83;
  --other: #59636e;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117;
    --fg: #e6edf3;
    --muted: #9198a1;
    --line: #3d444d;
    --panel: #151b23;
    --link: #4493f8;
    --get: #3fb950;
    --post: #d29922;
    --put: #4493f8;
    --patch: #ab7df8;
    --delete: #f85149;
    --head: #39c5cf;
    --other: #9198a1;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0 auto;
  max-width: 960px;
  padding: 24px 16px 48px;
  background: var(--bg);
  color: var(--fg);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
a { color: var(--link); }
h1, h2, h3, h4 { line-height: 1.25; margin: 1.5em 0 0.5em; }
header h1 { margin-top: 0; }
nav { border: 1px solid var(--line); border-radius: 6px; padding: 8px 16px; background: var(--panel); }
nav h2 { margin-top: 0.5em; font-size: 1em; }
nav ul { padding-left: 1.25em; }
section, article { margin-top: 1.5em; }
article { border-top: 1px solid var(--line); padding-top: 0.5em; }
code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace; font-size: 0.9em; }
pre { overflow-x: auto; padding: 12px; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; }
.url { overflow-wrap: anywhere; }
.docs { color: var(--fg); }
.note, caption { color: var(--muted); }
caption { text-align: left; font-weight: 600; padding: 4px 0; }
table { display: block; overflow-x: auto; border-collapse: collapse; margin: 8px 0; max-width: 100%; }
th, td { border: 1px solid var(--line); padding: 4px 8px; text-align: left; vertical-align: top; }
th { background: var(--panel); }
tr.disabled td { opacity: 0.55; }
.tag { margin-left: 6px; padding: 0 6px; border: 1px solid var(--line); border-radius: 10px; font-size: 0.8em; color: var(--muted); }
.method { display: inline-block; min-width: 4.5em; padding: 1px 6px; border-radius: 4px; color: #ffffff; font: 600 0.8em ui-monospace, Menlo, Consolas, monospace; text-align: center; background: var(--other); }
.m-get { background: var(--get); }
.m-post { background: var(--post); }
.m-put { background: var(--put); }
.m-patch { background: var(--patch); }
.m-delete { background: var(--delete); }
.m-head, .m-options, .m-trace { background: var(--head); }
.m-other { background: var(--other); }
</style>
</head>
<body>
<header>
<h1>Inheritance YML</h1>
</header>
<nav>
<h2>Contents</h2>
<ul>
<li><a href="#r-1"><span class="method m-post">POST</span> echo</a></li>
<li><a href="#r-2"><span class="method m-post">POST</span> workspace-vars</a></li>
<li><a href="#r-3"><span class="method m-get">GET</span> set-env-var</a></li>
<li><a href="#r-4"><span class="method m-get">GET</span> set-global-env-var</a></li>
</ul>
</nav>
<main>
<article id="r-1">
<h3><span class="method m-post">POST</span> echo</h3>
<p class="url"><code>{{host}}/api/echo/everything</code></p>
<p class="part">Body (json)</p>
<pre>{
  &quot;api_url&quot;: &quot;{{api_url}}&quot;,
  &quot;base_only&quot;: &quot;{{base_only}}&quot;,
  &quot;dev_only&quot;: &quot;{{dev_only}}&quot;,
  &quot;disabled_in_base&quot;: &quot;{{disabled_in_base}}&quot;,
  &quot;shadowed_by_disabled&quot;: &quot;{{shadowed_by_disabled}}&quot;,
  &quot;base_number&quot;: {{base_number}},
  &quot;base_boolean&quot;: {{base_boolean}},
  &quot;base_object&quot;: {{base_object}},
  &quot;typed_override&quot;: &quot;{{typed_override}}&quot;,
  &quot;base_token&quot;: &quot;{{base_token}}&quot;,
  &quot;api_key&quot;: &quot;{{api_key}}&quot;,
  &quot;overridden_plain&quot;: &quot;{{overridden_plain}}&quot;,
  &quot;overridden_secret&quot;: &quot;{{overridden_secret}}&quot;
}</pre>
<p class="auth">Auth: No auth</p>
</article>
<article id="r-2">
<h3><span class="method m-post">POST</span> workspace-vars</h3>
<p class="url"><code>{{workspace_host}}/api/echo/everything</code></p>
<p class="part">Body (json)</p>
<pre>{
  &quot;workspace_base_only&quot;: &quot;{{workspace_base_only}}&quot;,
  &quot;workspace_overridden&quot;: &quot;{{workspace_overridden}}&quot;,
  &quot;workspace_dev_only&quot;: &quot;{{workspace_dev_only}}&quot;,
  &quot;workspace_disabled&quot;: &quot;{{workspace_disabled}}&quot;,
  &quot;workspace_shadowed_by_disabled&quot;: &quot;{{workspace_shadowed_by_disabled}}&quot;,
  &quot;workspace_number&quot;: {{workspace_number}},
  &quot;workspace_boolean&quot;: {{workspace_boolean}},
  &quot;workspace_object&quot;: {{workspace_object}},
  &quot;workspace_typed_override&quot;: &quot;{{workspace_typed_override}}&quot;,
  &quot;workspace_token&quot;: &quot;{{workspace_token}}&quot;,
  &quot;workspace_api_key&quot;: &quot;{{workspace_api_key}}&quot;,
  &quot;workspace_overridden_plain&quot;: &quot;{{workspace_overridden_plain}}&quot;,
  &quot;workspace_overridden_secret&quot;: &quot;{{workspace_overridden_secret}}&quot;
}</pre>
<p class="auth">Auth: No auth</p>
</article>
<article id="r-3">
<h3><span class="method m-get">GET</span> set-env-var</h3>
<p class="url"><code>{{host}}/ping</code></p>
<p class="auth">Auth: No auth</p>
</article>
<article id="r-4">
<h3><span class="method m-get">GET</span> set-global-env-var</h3>
<p class="url"><code>{{workspace_host}}/ping</code></p>
<p class="auth">Auth: No auth</p>
</article>
</main>
</body>
</html>
--- notes
