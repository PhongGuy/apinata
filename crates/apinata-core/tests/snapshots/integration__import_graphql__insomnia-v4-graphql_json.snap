== Users/User by id.yml
info:
  name: User by id
  type: graphql
  seq: 1

graphql:
  method: POST
  url: "{{base_url}}/graphql"
  headers:
    - name: Content-Type
      value: application/json
    - name: X-Trace
      value: on
      disabled: true
  body:
    query: "query User($id: ID!) { user(id: $id) { id name } }"
    variables: |-
      {
        "id": "{{user_id}}"
      }
  auth:
    type: bearer
    token: "{{token}}"

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
