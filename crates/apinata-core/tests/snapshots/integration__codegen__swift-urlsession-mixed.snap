import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

var request = URLRequest(url: URL(string: "http://x.test/x")!)
request.httpMethod = "POST"
request.setValue("multipart/form-data; boundary=apinata-boundary-5f0c2e9a7d4b", forHTTPHeaderField: "Content-Type")
var body = Data()
body.append(Data("--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name=\"j\"\r\nContent-Type: application/json\r\n\r\n{\"a\": 1}\r\n--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name=\"q%22x\"\r\n\r\nplain\r\n--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name=\"up\"; filename=\"up.bin\"\r\nContent-Type: text/plain\r\n\r\n".utf8))
body.append(try! Data(contentsOf: URL(fileURLWithPath: "/data/up.bin")))
body.append(Data("\r\n--apinata-boundary-5f0c2e9a7d4b--\r\n".utf8))
request.httpBody = body

let done = DispatchSemaphore(value: 0)
URLSession.shared.dataTask(with: request) { data, response, error in
    if let response = response as? HTTPURLResponse {
        print(response.statusCode)
        print(String(decoding: data ?? Data(), as: UTF8.self))
    } else if let error = error {
        print(error)
    }
    done.signal()
}.resume()
done.wait()
