# Template Tag Collection
== Base Response.yml
info:
  name: Base Response
  type: http
  seq: 11

http:
  method: GET
  url: http://127.0.0.1:4010/echo
  headers:
    - name: User-Agent
      value: insomnia/11.1.0
  body:
    type: form-urlencoded
    data:
      - name: foo
        value: bar
  auth: inherit

runtime:
  actions:
    - type: set-variable
      phase: after-response
      selector:
        expression: res.body.method
        method: jsonq
      variable:
        name: res_base_response_method
        scope: runtime
    - type: set-variable
      phase: after-response
      selector:
        expression: res.headers['content-type']
        method: jsonq
      variable:
        name: res_base_response_content_type
        scope: runtime

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
