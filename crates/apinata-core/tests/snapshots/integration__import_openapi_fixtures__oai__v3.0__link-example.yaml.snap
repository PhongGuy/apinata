info:
  name: getPullRequestsById
  type: http
  seq: 5

http:
  method: GET
  url: "{{baseUrl}}/2.0/repositories/:username/:slug/pullrequests/:pid"
  params:
    - name: username
      value: ""
      type: path
    - name: slug
      value: ""
      type: path
    - name: pid
      value: ""
      type: path
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: 200 Response
    description: a pull request object
    request:
      url: "{{baseUrl}}/2.0/repositories/:username/:slug/pullrequests/:pid"
      method: GET
      params:
        - name: username
          value: ""
          type: path
        - name: slug
          value: ""
          type: path
        - name: pid
          value: ""
          type: path
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "id": 0,
            "title": "",
            "repository": {
              "slug": "",
              "owner": {
                "username": "",
                "uuid": ""
              }
            },
            "author": {
              "username": "",
              "uuid": ""
            }
          }

=== getPullRequestsByRepository.yml
info:
  name: getPullRequestsByRepository
  type: http
  seq: 4

http:
  method: GET
  url: "{{baseUrl}}/2.0/repositories/:username/:slug/pullrequests"
  params:
    - name: username
      value: ""
      type: path
    - name: slug
      value: ""
      type: path
    - name: state
      value: open
      type: query
      disabled: true
    - name: state
      value: merged
      type: query
      disabled: true
    - name: state
      value: declined
      type: query
      disabled: true
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: 200 Response
    description: an array of pull request objects
    request:
      url: "{{baseUrl}}/2.0/repositories/:username/:slug/pullrequests"
      method: GET
      params:
        - name: username
          value: ""
          type: path
        - name: slug
          value: ""
          type: path
        - name: state
          value: open
          type: query
          disabled: true
        - name: state
          value: merged
          type: query
          disabled: true
        - name: state
          value: declined
          type: query
          disabled: true
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          [
            {
              "id": 0,
              "title": "",
              "repository": {
                "slug": "",
                "owner": {
                  "username": "",
                  "uuid": ""
                }
              },
              "author": {
                "username": "",
                "uuid": ""
              }
            }
          ]

