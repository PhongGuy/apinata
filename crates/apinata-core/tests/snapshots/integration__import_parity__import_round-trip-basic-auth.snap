== Own Auth.yml
info:
  name: Own Auth
  type: http
  seq: 2

http:
  method: GET
  url: http://localhost:3000/health
  auth:
    type: basic
    username: john-custom
    password: "{{own_auth_password}}"

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
== environments/Environment.yml
name: Environment
variables:
  - secret: true
    name: basic_auth_password
  - secret: true
    name: own_auth_password
== opencollection.yml
opencollection: 1.0.0

info:
  name: Basic Auth

request:
  auth:
    type: basic
    username: john
    password: "{{basic_auth_password}}"
bundled: false
extensions:
  bruno:
    ignore:
      - node_modules
      - .git
