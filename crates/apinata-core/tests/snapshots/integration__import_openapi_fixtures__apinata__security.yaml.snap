=== OAuth.yml
info:
  name: OAuth
  type: http
  seq: 5

http:
  method: GET
  url: "{{baseUrl}}/oauth"
  auth:
    type: oauth2
    flow: client_credentials
    accessTokenUrl: https://secure.example.test/token
    credentials:
      clientId: "{{clientId}}"
      clientSecret: "{{clientSecret}}"
      placement: body
    scope: read
    tokenConfig:
      id: credentials
      placement:
        header: Bearer
      source: access_token
    settings:
      autoFetchToken: true
      autoRefreshToken: false

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

