import axios from 'axios';

const url = 'http://x.test/t';
const headers = {
  'Content-Type': 'multipart/form-data; boundary=apinata-boundary-5f0c2e9a7d4b',
};
const data = Buffer.concat([
  Buffer.from('--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="j"\r\nContent-Type: application/json\r\n\r\n{"a": "x﻿y"}\r\n--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="t"\r\n\r\nplain\r\n--apinata-boundary-5f0c2e9a7d4b--\r\n'),
]);

const response = await axios.request({
  method: 'POST',
  url,
  headers,
  data,
  transformRequest: (d) => d,
  transformResponse: (r) => r,
  validateStatus: () => true,
});
console.log(response.status);
console.log(response.data);
