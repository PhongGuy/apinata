{
  "openapi": "3.1.0",
  "info": {
    "title": "Apinata Demo",
    "version": "1.0.0",
    "description": "# Apinata Demo\n\nA small tour of Apinata.\n\n- **Posts** and **Users** call [JSONPlaceholder](https://jsonplaceholder.typicode.com), a free fake REST API.\n- **Media** calls [httpbin](https://httpbin.org) for responses that are not JSON.\n- **Auth** shows digest, NTLM, AWS Sig v4 signing and an OAuth 1.0 signature httpbin echoes.\n\nSending a request needs network access."
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "variables": {
        "baseUrl": {
          "default": "https://jsonplaceholder.typicode.com"
        }
      }
    },
    {
      "url": "https://jsonplaceholder.typicode.com",
      "description": "JSONPlaceholder"
    }
  ],
  "tags": [
    {
      "name": "Posts"
    },
    {
      "name": "Users"
    },
    {
      "name": "Media",
      "description": "## Media\n\nResponses that are not JSON:\n\n1. **Get XML** returns an XML document, shown re-indented and highlighted.\n2. **Get PNG** returns a PNG image, shown as a preview with its size and dimensions."
    },
    {
      "name": "Auth"
    },
    {
      "name": "GraphQL"
    }
  ],
  "paths": {
    "/posts": {
      "get": {
        "tags": [
          "Posts"
        ],
        "summary": "List posts",
        "operationId": "postsListPosts",
        "parameters": [
          {
            "name": "_limit",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "5"
          }
        ],
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      },
      "post": {
        "tags": [
          "Posts"
        ],
        "summary": "Create post",
        "operationId": "postsCreatePost",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "userId": {
                    "type": "integer"
                  }
                }
              },
              "example": {
                "title": "Hello from Apinata",
                "body": "A demo post.",
                "userId": 1
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      }
    },
    "/posts/{id}": {
      "get": {
        "tags": [
          "Posts"
        ],
        "summary": "Get post",
        "description": "Fetches the post named by the `postId` collection variable and keeps its title as `postTitle`.",
        "operationId": "postsGetPost",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{postId}}"
          }
        ],
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      }
    },
    "/posts/1": {
      "put": {
        "tags": [
          "Posts"
        ],
        "summary": "Replace post",
        "operationId": "postsReplacePost",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "userId": {
                    "type": "integer"
                  }
                }
              },
              "example": {
                "id": 1,
                "title": "Replaced",
                "body": "A replaced post.",
                "userId": 1
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      },
      "patch": {
