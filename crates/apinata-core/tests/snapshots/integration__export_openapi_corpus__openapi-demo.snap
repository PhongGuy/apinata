        ],
        "summary": "Edit post title",
        "operationId": "postsEditPostTitle",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "title": "Edited"
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      },
      "delete": {
        "tags": [
