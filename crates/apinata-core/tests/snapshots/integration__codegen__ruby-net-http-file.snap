# Net::HTTP does not follow redirects; this prints the first response.
require "net/http"

uri = URI("http://x.test/b")
request = Net::HTTP::Put.new(uri)
request["content-type"] = "application/json"
request.body = File.binread("/data/body.json")

response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == "https") do |http|
  http.request(request)
end
puts response.code
puts response.body
