== coll-v2-child/req-v3-II.yml
info:
  name: req-v3-II
  type: http
  seq: 1

http:
  method: GET
  url: https://echo.hoppscotch.io?key={{req_v3_ii_key}}
  headers:
    - name: Inactive-Header
      value: Inactive Header
      disabled: true
    - name: Authorization
      value: "{{req_v3_ii_authorization}}"
  params:
    - name: key
      value: "{{req_v3_ii_key}}"
      type: query
    - name: inactive-key
      value: inactive-param
      type: query
      disabled: true
  auth:
    type: bearer
    token: "{{req_v3_ii_token}}"

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
