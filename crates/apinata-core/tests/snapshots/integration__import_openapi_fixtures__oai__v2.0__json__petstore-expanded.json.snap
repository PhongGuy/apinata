=== addPet.yml
info:
  name: addPet
  type: http
  seq: 2

http:
  method: POST
  url: "{{baseUrl}}/pets"
  body:
    type: json
    data: |-
      {
        "name": "",
        "tag": ""
      }
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

docs: Creates a new pet in the store.  Duplicates are allowed

=== deletePet.yml
info:
  name: deletePet
  type: http
  seq: 4

http:
  method: DELETE
  url: "{{baseUrl}}/pets/:id"
  params:
    - name: id
      value: ""
      type: path
      description: ID of pet to delete
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

docs: deletes a single pet based on the ID supplied

=== environments/Environment.yml
name: Environment
variables:
  - name: baseUrl
    value: http://petstore.swagger.io/api

=== find pet by id.yml
info:
  name: find pet by id
  type: http
  seq: 3

http:
  method: GET
  url: "{{baseUrl}}/pets/:id"
  params:
    - name: id
      value: ""
      type: path
      description: ID of pet to fetch
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

docs: Returns a user based on a single ID, if the user does not have access to the pet

=== findPets.yml
info:
  name: findPets
  type: http
  seq: 1

http:
  method: GET
  url: "{{baseUrl}}/pets"
  params:
    - name: tags
      value: ""
      type: query
      description: tags to filter by
      disabled: true
    - name: limit
      value: ""
      type: query
      description: maximum number of results to return
      disabled: true
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

docs: |
  Returns all pets from the system that the user has access to
