== Own Auth.yml
info:
  name: Own Auth
  type: http
  seq: 2

http:
  method: GET
  url: http://localhost:3000/health
  auth:
    type: akamai-edgegrid
    accessToken: "{{own_auth_access_token}}"
    clientToken: "{{own_auth_client_token}}"
    clientSecret: "{{own_auth_client_secret}}"
    nonce: ""
    timestamp: ""
    baseURL: ""
    headersToSign: ""

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
