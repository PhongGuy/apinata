== Own Auth.yml
info:
  name: Own Auth
  type: http
  seq: 2

http:
  method: GET
  url: http://localhost:3000/health
  auth:
    type: akamai-edgegrid
    accessToken: "{{own_auth_access_token}}"
    clientToken: "{{own_auth_client_token}}"
    clientSecret: "{{own_auth_client_secret}}"
    nonce: ""
    timestamp: ""
    baseURL: ""
    headersToSign: ""

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
== environments/Environment.yml
name: Environment
variables:
  - secret: true
    name: own_auth_access_token
  - secret: true
    name: own_auth_client_token
  - secret: true
    name: own_auth_client_secret
== opencollection.yml
opencollection: 1.0.0

info:
  name: Akamai EdgeGrid

request:
  auth:
    type: akamai-edgegrid
    accessToken: "{{accessToken}}"
    clientToken: "{{client_token}}"
    clientSecret: "{{secret}}"
    nonce: Nonce
    timestamp: 20260707T10:28:15+0000
    baseURL: http://localhost:4000
    headersToSign: Auth
    maxBodySize: 70
bundled: false
extensions:
  bruno:
    ignore:
      - node_modules
      - .git
    presets:
      defaultEnvironment: Environment
