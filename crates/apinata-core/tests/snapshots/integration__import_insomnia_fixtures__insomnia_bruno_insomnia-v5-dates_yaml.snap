# Date Type Test
== Date Request.yml
info:
  name: Date Request
  type: http
  seq: 1

http:
  method: GET
  url: http://example.com/test?date=2024-01-01&is_active=false&limit=0&version=2.0&count=42
  params:
    - name: date
      value: 2024-01-01
      type: query
    - name: is_active
      value: "false"
      type: query
    - name: limit
      value: "0"
      type: query
    - name: version
      value: "2.0"
      type: query
    - name: count
      value: "42"
      type: query
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
