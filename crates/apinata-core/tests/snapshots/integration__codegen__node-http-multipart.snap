// Node's http module does not follow redirects; this prints the first response.
import fs from 'node:fs';
import http from 'node:http';

const url = 'http://x.test/m';
const headers = {
  'Content-Type': 'multipart/form-data; boundary=apinata-boundary-5f0c2e9a7d4b',
};
const body = Buffer.concat([
  Buffer.from('--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="a"\r\n\r\n1\r\n--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="up"; filename="up.bin"\r\nContent-Type: text/plain\r\n\r\n'),
  fs.readFileSync('/data/up.bin'),
  Buffer.from('\r\n--apinata-boundary-5f0c2e9a7d4b--\r\n'),
]);

const req = http.request(url, { method: 'POST', headers }, (res) => {
  console.log(res.statusCode);
  const chunks = [];
  res.on('data', (chunk) => chunks.push(chunk));
  res.on('end', () => console.log(Buffer.concat(chunks).toString()));
});
req.end(body);
