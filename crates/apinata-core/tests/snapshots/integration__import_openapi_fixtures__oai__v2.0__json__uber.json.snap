        - name: latitude
          value: ""
          type: query
          description: Latitude component of location.
        - name: longitude
          value: ""
          type: query
          description: Longitude component of location.
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
