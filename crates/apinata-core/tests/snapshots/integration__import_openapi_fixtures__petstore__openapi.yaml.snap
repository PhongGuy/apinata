=== pet/Add a new pet to the store.yml
info:
  name: Add a new pet to the store
  type: http
  seq: 2
  tags:
    - pet

http:
  method: POST
  url: "{{baseUrl}}/pet"
  body:
    type: json
    data: |-
      {
        "id": 10,
        "name": "doggie",
        "category": {
          "id": 1,
          "name": "Dogs"
        },
        "photoUrls": [],
        "tags": [
          {
            "id": 0,
            "name": ""
          }
        ],
        "status": "available"
      }
  auth:
    type: oauth2
    flow: implicit
    authorizationUrl: https://petstore3.swagger.io/oauth/authorize
    credentials:
      clientId: "{{clientId}}"
    scope: write:pets read:pets
    tokenConfig:
      id: credentials
      placement:
        header: Bearer
      source: access_token
    settings:
      autoFetchToken: true
      autoRefreshToken: false

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: 200 Response
    description: Successful operation
    request:
      url: "{{baseUrl}}/pet"
      method: POST
      body:
        type: json
        data: |-
          {
            "id": 10,
            "name": "doggie",
            "category": {
              "id": 1,
              "name": "Dogs"
            },
            "photoUrls": [],
            "tags": [
              {
                "id": 0,
                "name": ""
              }
            ],
            "status": "available"
          }
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "id": 10,
            "name": "doggie",
            "category": {
              "id": 1,
              "name": "Dogs"
            },
            "photoUrls": [],
            "tags": [
              {
                "id": 0,
                "name": ""
              }
            ],
            "status": "available"
          }
  - name: 200 Response
    description: Successful operation
    request:
      url: "{{baseUrl}}/pet"
      method: POST
      body:
        type: json
        data: |-
          {
            "id": 10,
            "name": "doggie",
            "category": {
              "id": 1,
              "name": "Dogs"
            },
            "photoUrls": [],
            "tags": [
              {
                "id": 0,
                "name": ""
              }
            ],
            "status": "available"
          }
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/xml
      body:
        type: xml
        data: |-
          <?xml version="1.0" encoding="UTF-8"?>
          <pet>
            <id></id>
            <name></name>
            <category>
              <id></id>
              <name></name>
            </category>
            <photoUrls></photoUrls>
            <tags></tags>
            <status></status>
          </pet>

docs: Add a new pet to the store.

=== pet/Deletes a pet.yml
info:
  name: Deletes a pet
  type: http
  seq: 7
  tags:
    - pet

http:
  method: DELETE
  url: "{{baseUrl}}/pet/:petId"
  headers:
    - name: api_key
      value: ""
      disabled: true
  params:
    - name: petId
      value: ""
      type: path
      description: Pet id to delete
  auth:
    type: oauth2
    flow: implicit
    authorizationUrl: https://petstore3.swagger.io/oauth/authorize
    credentials:
      clientId: "{{clientId}}"
    scope: write:pets read:pets
    tokenConfig:
      id: credentials
      placement:
        header: Bearer
      source: access_token
    settings:
      autoFetchToken: true
      autoRefreshToken: false

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

