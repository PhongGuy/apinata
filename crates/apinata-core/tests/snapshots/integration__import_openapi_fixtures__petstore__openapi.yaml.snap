=== pet/Uploads an image.yml
info:
  name: Uploads an image
  type: http
  seq: 8
  tags:
    - pet

http:
  method: POST
  url: "{{baseUrl}}/pet/:petId/uploadImage"
  params:
    - name: petId
      value: ""
      type: path
      description: ID of pet to update
    - name: additionalMetadata
      value: ""
      type: query
      description: Additional Metadata
      disabled: true
  body:
    type: text
    data: ""
  auth:
    type: oauth2
    flow: implicit
    authorizationUrl: https://petstore3.swagger.io/oauth/authorize
    credentials:
      clientId: "{{clientId}}"
    scope: write:pets read:pets
    tokenConfig:
      id: credentials
      placement:
        header: Bearer
      source: access_token
    settings:
      autoFetchToken: true
      autoRefreshToken: false

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: 200 Response
    description: successful operation
    request:
      url: "{{baseUrl}}/pet/:petId/uploadImage"
      method: POST
      params:
        - name: petId
          value: ""
          type: path
          description: ID of pet to update
        - name: additionalMetadata
          value: ""
          type: query
          description: Additional Metadata
          disabled: true
      body:
        type: text
        data: ""
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "code": 0,
            "type": "",
            "message": ""
          }

