=== pet/Finds Pets by status.yml
info:
  name: Finds Pets by status
  type: http
  seq: 3
  tags:
    - pet

http:
  method: GET
  url: "{{baseUrl}}/pet/findByStatus?status=available"
  params:
    - name: status
      value: available
      type: query
      description: Status values that need to be considered for filter
    - name: status
      value: pending
      type: query
      description: Status values that need to be considered for filter
      disabled: true
    - name: status
      value: sold
      type: query
      description: Status values that need to be considered for filter
      disabled: true
  auth:
    type: oauth2
    flow: implicit
    authorizationUrl: https://petstore3.swagger.io/oauth/authorize
    credentials:
      clientId: "{{clientId}}"
    scope: write:pets read:pets
    tokenConfig:
      id: credentials
      placement:
        header: Bearer
      source: access_token
    settings:
      autoFetchToken: true
      autoRefreshToken: false

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: 200 Response
    description: successful operation
    request:
      url: "{{baseUrl}}/pet/findByStatus?status=available"
      method: GET
      params:
        - name: status
          value: available
          type: query
          description: Status values that need to be considered for filter
        - name: status
          value: pending
          type: query
          description: Status values that need to be considered for filter
          disabled: true
        - name: status
          value: sold
          type: query
          description: Status values that need to be considered for filter
          disabled: true
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          [
            {
              "id": 10,
              "name": "doggie",
              "category": {
                "id": 1,
                "name": "Dogs"
              },
              "photoUrls": [],
              "tags": [
                {
                  "id": 0,
                  "name": ""
                }
              ],
              "status": "available"
            }
          ]
  - name: 200 Response
    description: successful operation
    request:
      url: "{{baseUrl}}/pet/findByStatus?status=available"
      method: GET
      params:
        - name: status
          value: available
          type: query
          description: Status values that need to be considered for filter
        - name: status
          value: pending
          type: query
          description: Status values that need to be considered for filter
          disabled: true
        - name: status
          value: sold
          type: query
          description: Status values that need to be considered for filter
          disabled: true
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/xml
      body:
        type: xml
        data: ""

docs: Multiple status values can be provided with comma separated strings.

