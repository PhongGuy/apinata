    - name: name
      value: ""
      type: query
      description: Name of pet that needs to be updated
      disabled: true
    - name: status
      value: ""
      type: query
      description: Status of pet that needs to be updated
      disabled: true
  auth:
    type: oauth2
    flow: implicit
    authorizationUrl: https://petstore3.swagger.io/oauth/authorize
    credentials:
      clientId: "{{clientId}}"
    scope: write:pets read:pets
    tokenConfig:
      id: credentials
      placement:
