    description: successful operation
    request:
      url: "{{baseUrl}}/pet/:petId"
      method: POST
      params:
        - name: petId
          value: ""
          type: path
          description: ID of pet that needs to be updated
        - name: name
          value: ""
          type: query
          description: Name of pet that needs to be updated
          disabled: true
        - name: status
          value: ""
          type: query
