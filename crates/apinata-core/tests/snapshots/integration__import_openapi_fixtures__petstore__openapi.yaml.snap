  type: http
  seq: 5
  tags:
    - pet

http:
  method: GET
  url: "{{baseUrl}}/pet/:petId"
  params:
    - name: petId
      value: ""
      type: path
      description: ID of pet to return
  auth:
    type: apikey
    key: api_key
    value: "{{apiKey}}"
    placement: header

