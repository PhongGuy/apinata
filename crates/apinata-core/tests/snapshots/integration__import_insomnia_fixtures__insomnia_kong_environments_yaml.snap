# environments
== New Request.yml
info:
  name: New Request
  type: http
  seq: 1

http:
  method: GET
  url: localhost:4010/
  headers:
    - name: Content-Type
      value: text/plain
  body:
    type: text
    data: |-
      {{exampleObject.anotherString}}
      {{exampleString}}
      {{exampleNumber}}
      {{exampleObject.anotherNumber}}
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
== environments/Base Environment.yml
name: Base Environment
variables:
  - name: exampleString
    value: baseenv0
  - name: exampleNumber
    value: "1001"
  - name: exampleObject.anotherString
    value: baseenv1
  - name: exampleObject.anotherNumber
    value: "1001"
