=== pets/Create a pet.yml
info:
  name: Create a pet
  type: http
  seq: 2
  tags:
    - pets

http:
  method: POST
  url: "{{baseUrl}}/pets"
  body:
    type: json
    data: |-
      {
        "id": 0,
        "name": "",
        "tag": ""
      }
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: default Response
    description: unexpected error
    request:
      url: "{{baseUrl}}/pets"
      method: POST
      body:
        type: json
        data: |-
          {
            "id": 0,
            "name": "",
            "tag": ""
          }
    response:
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "code": 0,
            "message": ""
          }

