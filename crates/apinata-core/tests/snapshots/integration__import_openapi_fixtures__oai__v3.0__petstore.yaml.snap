info:
  name: Info for a specific pet
  type: http
  seq: 3
  tags:
    - pets

http:
  method: GET
  url: "{{baseUrl}}/pets/:petId"
  params:
    - name: petId
      value: ""
      type: path
      description: The id of the pet to retrieve
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
