  type: graphql
  seq: 3

graphql:
  method: POST
  url: https://api.example.test/graphql
  body:
    query: "{ me { id } }"
    variables: "{}"
  auth:
    type: basic
    username: ann
    password: "{{pw}}"

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
== Users/User by id.yml
info:
  name: User by id
  type: graphql
  seq: 1

graphql:
  method: POST
  url: "{{baseUrl}}/graphql"
  headers:
    - name: X-Trace
      value: on
      disabled: true
  body:
    query: "query User($id: ID!) { user(id: $id) { id name } }"
    variables: |-
      {
        "id": "{{userId}}"
      }
  auth:
    type: bearer
    token: "{{token}}"

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

docs: Looks up one user
