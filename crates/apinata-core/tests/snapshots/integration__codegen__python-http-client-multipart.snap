# http.client does not follow redirects; this prints the first response.
import http.client
from pathlib import Path

conn = http.client.HTTPConnection('x.test')
headers = {
    'Content-Type': 'multipart/form-data; boundary=apinata-boundary-5f0c2e9a7d4b',
}
body = b''.join([
    '--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="a"\r\n\r\n1\r\n--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="up"; filename="up.bin"\r\nContent-Type: text/plain\r\n\r\n'.encode('utf-8'),
    Path('/data/up.bin').read_bytes(),
    '\r\n--apinata-boundary-5f0c2e9a7d4b--\r\n'.encode('utf-8'),
])

conn.request('POST', '/m', body=body, headers=headers)
response = conn.getresponse()
print(response.status)
print(response.read().decode('utf-8', 'replace'))
