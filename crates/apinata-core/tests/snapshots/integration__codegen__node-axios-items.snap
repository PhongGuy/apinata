import axios from 'axios';

const url = 'http://x.test/i';
const headers = {
  'X-E': '=v',
};
const form = new FormData();
form.append('a', '@x');
form.append('k=v', '1');
const data = form;

const response = await axios.request({
  method: 'POST',
  url,
  headers,
  data,
  transformRequest: (d) => d,
  transformResponse: (r) => r,
  validateStatus: () => true,
});
console.log(response.status);
console.log(response.data);
