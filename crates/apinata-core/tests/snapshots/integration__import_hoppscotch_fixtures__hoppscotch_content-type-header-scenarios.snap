== content-type-header-assignment.yml
info:
  name: content-type-header-assignment
  type: http
  seq: 1

http:
  method: POST
  url: https://echo.hoppscotch.io
  body:
    type: xml
    data: |
      <?xml version="1.0" encoding="UTF-8"?>
      <request>
          <user>
              <id>12345</id>
              <name>John Doe</name>
              <email>john.doe@example.com</email>
          </user>
          <order>
              <id>98765</id>
              <product>Sample Product</product>
              <quantity>2</quantity>
          </order>
      </request>
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
