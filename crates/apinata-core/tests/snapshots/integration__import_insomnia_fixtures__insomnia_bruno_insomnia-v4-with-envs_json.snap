# Test API Collection v4 with Environments
== Get Users.yml
info:
  name: Get Users
  type: http
  seq: 1

http:
  method: GET
  url: "{{baseUrl}}/api/users"
  headers:
    - name: Accept
      value: application/json
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

docs: Fetch all users from the API
== environments/Base Environment.yml
name: Base Environment
variables:
  - name: baseUrl
    value: https://api.example.com
  - name: authToken
    value: your_auth_token_here
  - name: user.name
    value: admin
  - name: user.id
    value: "123"
  - name: user.roles[0]
    value: admin
  - name: user.roles[1]
    value: user
  - name: config.timeout
    value: "30000"
  - name: config.retries
    value: "3"
  - name: config.debug
    value: "true"
== environments/Development.yml
name: Development
variables:
  - name: baseUrl
    value: https://dev-api.example.com
  - name: authToken
    value: dev_token_123
  - name: user.name
    value: admin
  - name: user.id
    value: "123"
  - name: user.roles[0]
    value: admin
  - name: user.roles[1]
    value: user
  - name: config.timeout
    value: "30000"
  - name: config.retries
    value: "3"
  - name: config.debug
    value: "true"
  - name: newFeature.enabled
    value: "true"
  - name: newFeature.version
    value: "2.099123123"
== environments/Staging.yml
name: Staging
variables:
  - name: baseUrl
    value: https://staging-api.example.com
  - name: authToken
    value: your_auth_token_here
  - name: user.name
    value: staging_admin
  - name: user.id
    value: "123"
  - name: user.roles[0]
    value: admin
  - name: user.roles[1]
    value: user
  - name: config.timeout
    value: "60000"
  - name: config.retries
    value: "3"
  - name: config.debug
    value: "false"
== opencollection.yml
opencollection: 1.0.0

info:
  name: Test API Collection v4 with Environments

docs:
  content: Test collection for Insomnia v4 format with environments
  type: text/markdown
bundled: false
extensions:
  bruno:
    ignore:
      - node_modules
      - .git
