# http.client does not follow redirects; this prints the first response.
import http.client

conn = http.client.HTTPConnection('x.test')
headers = {
    'X-E': '=v',
    'Content-Type': 'multipart/form-data; boundary=apinata-boundary-5f0c2e9a7d4b',
}
body = b''.join([
    '--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="a"\r\n\r\n@x\r\n--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="k=v"\r\n\r\n1\r\n--apinata-boundary-5f0c2e9a7d4b--\r\n'.encode('utf-8'),
])

conn.request('POST', '/i', body=body, headers=headers)
response = conn.getresponse()
print(response.status)
print(response.read().decode('utf-8', 'replace'))
