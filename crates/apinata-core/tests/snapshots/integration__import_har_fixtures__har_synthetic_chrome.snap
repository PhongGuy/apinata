== api.shop.test/GET -me.yml
info:
  name: GET /me
  type: http
  seq: 1

http:
  method: GET
  url: https://api.shop.test/me
  headers:
    - name: cookie
      value: "{{api_shop_test_cookie}}"
    - name: user-agent
      value: Mozilla/5.0
  auth:
    type: basic
    username: "{{api_shop_test_username}}"
    password: "{{api_shop_test_password}}"

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
== api.shop.test/POST -orders.yml
info:
  name: POST /orders
  type: http
  seq: 2

http:
  method: POST
  url: https://api.shop.test/orders?src=web&access_token={{api_shop_test_access_token}}
  headers:
    - name: content-type
      value: application/json
  params:
    - name: src
      value: web
      type: query
    - name: access_token
      value: "{{api_shop_test_access_token}}"
      type: query
  body:
    type: json
    data: '{"qty":1}'
  auth:
    type: bearer
    token: "{{api_shop_test_token}}"

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
== api.shop.test/POST -upload.yml
info:
  name: POST /upload
  type: http
  seq: 3

http:
  method: POST
  url: https://api.shop.test/upload
  headers:
    - name: authorization
      value: "{{api_shop_test_authorization}}"
    - name: proxy-authorization
      value: "{{api_shop_test_proxy_authorization}}"
    - name: content-type
      value: multipart/form-data; boundary=B
  body:
    type: multipart-form
    data:
      - name: title
        type: text
        value: Hi
      - name: file
        type: file
        value:
          - ""

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
