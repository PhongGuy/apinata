using System;
using System.Net;
using System.Net.Http;

var client = new HttpClient(new HttpClientHandler { Credentials = new NetworkCredential("alice", "p'w") });
var request = new HttpRequestMessage(new HttpMethod("GET"), "http://x.test/digest");

var response = await client.SendAsync(request);
Console.WriteLine((int)response.StatusCode);
Console.WriteLine(await response.Content.ReadAsStringAsync());
