<?php

$curl = curl_init();
curl_setopt_array($curl, [
    CURLOPT_URL => "http://x.test/t",
    CURLOPT_CUSTOMREQUEST => "POST",
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_HTTPHEADER => [
        "Content-Type: multipart/form-data; boundary=apinata-boundary-5f0c2e9a7d4b",
    ],
    CURLOPT_POSTFIELDS => "--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name=\"j\"\r\nContent-Type: application/json\r\n\r\n{\"a\": \"x﻿y\"}\r\n--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name=\"t\"\r\n\r\nplain\r\n--apinata-boundary-5f0c2e9a7d4b--\r\n",
]);

$response = curl_exec($curl);
echo curl_getinfo($curl, CURLINFO_RESPONSE_CODE), "\n";
echo $response, "\n";
