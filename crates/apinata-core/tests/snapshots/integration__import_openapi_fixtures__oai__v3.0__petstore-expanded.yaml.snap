=== addPet.yml
info:
  name: addPet
  type: http
  seq: 2

http:
  method: POST
  url: "{{baseUrl}}/pets"
  body:
    type: json
    data: |-
      {
        "name": "",
        "tag": ""
      }
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: 200 Response
    description: pet response
    request:
      url: "{{baseUrl}}/pets"
      method: POST
      body:
        type: json
        data: |-
          {
            "name": "",
            "tag": ""
          }
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "name": "",
            "tag": "",
            "id": 0
          }
  - name: default Response
    description: unexpected error
    request:
      url: "{{baseUrl}}/pets"
      method: POST
      body:
        type: json
        data: |-
          {
            "name": "",
            "tag": ""
          }
    response:
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "code": 0,
            "message": ""
          }

docs: Creates a new pet in the store. Duplicates are allowed

=== deletePet.yml
info:
  name: deletePet
  type: http
  seq: 4

http:
  method: DELETE
  url: "{{baseUrl}}/pets/:id"
  params:
    - name: id
      value: ""
      type: path
      description: ID of pet to delete
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: default Response
    description: unexpected error
    request:
      url: "{{baseUrl}}/pets/:id"
      method: DELETE
      params:
        - name: id
          value: ""
          type: path
          description: ID of pet to delete
    response:
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "code": 0,
            "message": ""
          }

docs: deletes a single pet based on the ID supplied

