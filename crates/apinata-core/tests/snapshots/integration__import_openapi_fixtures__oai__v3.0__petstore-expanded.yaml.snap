=== findPets.yml
info:
  name: findPets
  type: http
  seq: 1

http:
  method: GET
  url: "{{baseUrl}}/pets"
  params:
    - name: tags
      value: "[]"
      type: query
      description: tags to filter by
      disabled: true
    - name: limit
      value: ""
      type: query
      description: maximum number of results to return
      disabled: true
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: 200 Response
    description: pet response
    request:
      url: "{{baseUrl}}/pets"
      method: GET
      params:
        - name: tags
          value: "[]"
          type: query
          description: tags to filter by
          disabled: true
        - name: limit
          value: ""
          type: query
          description: maximum number of results to return
          disabled: true
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          [
            {
              "name": "",
              "tag": "",
              "id": 0
            }
          ]
  - name: default Response
    description: unexpected error
    request:
      url: "{{baseUrl}}/pets"
      method: GET
      params:
        - name: tags
          value: "[]"
          type: query
          description: tags to filter by
          disabled: true
        - name: limit
          value: ""
          type: query
          description: maximum number of results to return
          disabled: true
    response:
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "code": 0,
            "message": ""
          }

docs: |
  Returns all pets from the system that the user has access to
