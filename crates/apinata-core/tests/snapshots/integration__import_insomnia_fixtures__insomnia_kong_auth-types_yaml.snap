# Auth tests
== environments/Base Environment.yml
name: Base Environment
variables:
  - name: customValue
    value: fromEnvManager
== opencollection.yml
opencollection: 1.0.0

info:
  name: Auth tests
bundled: false
extensions:
  bruno:
    ignore:
      - node_modules
      - .git
== sends request with basic authentication.yml
info:
  name: sends request with basic authentication
  type: http
  seq: 2

http:
  method: GET
  url: http://127.0.0.1:4010/auth/basic
  headers:
    - name: Authorization
      value: Basic dXNlcjpwYXNz
      disabled: true
  auth:
    type: basic
    username: user
    password: pass

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
== sends request with oauth1.yml
