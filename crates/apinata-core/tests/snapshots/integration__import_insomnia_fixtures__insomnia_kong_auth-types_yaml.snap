# Auth tests
== environments/Base Environment.yml
name: Base Environment
variables:
  - name: customValue
    value: fromEnvManager
  - secret: true
    name: sends_request_with_basic_authentication_password
  - secret: true
    name: sends_request_with_basic_authentication_authorization
== opencollection.yml
opencollection: 1.0.0

info:
  name: Auth tests
bundled: false
extensions:
  bruno:
    ignore:
      - node_modules
      - .git
    presets:
      defaultEnvironment: Base Environment
== sends request with basic authentication.yml
info:
  name: sends request with basic authentication
  type: http
  seq: 2

http:
  method: GET
  url: http://127.0.0.1:4010/auth/basic
  headers:
    - name: Authorization
      value: "{{sends_request_with_basic_authentication_authorization}}"
      disabled: true
  auth:
    type: basic
    username: user
    password: "{{sends_request_with_basic_authentication_password}}"

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
== sends request with oauth1.yml
info:
  name: sends request with oauth1
  type: http
  seq: 1

http:
  method: GET
  url: http://127.0.0.1:4010/auth/oauth1
  headers:
    - name: User-Agent
      value: insomnia/12.5.1-alpha.0

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
-- report
