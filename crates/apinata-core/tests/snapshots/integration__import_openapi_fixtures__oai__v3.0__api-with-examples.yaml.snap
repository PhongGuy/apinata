=== List API versions.yml
info:
  name: List API versions
  type: http
  seq: 1

http:
  method: GET
  url: "{{baseUrl}}/"
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: foo
    request:
      url: "{{baseUrl}}/"
      method: GET
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "versions": [
              {
                "status": "CURRENT",
                "updated": "2011-01-21T11:33:21Z",
                "id": "v2.0",
                "links": [
                  {
                    "href": "http://127.0.0.1:8774/v2/",
                    "rel": "self"
                  }
                ]
              },
              {
                "status": "EXPERIMENTAL",
                "updated": "2013-07-23T11:33:21Z",
                "id": "v3.0",
                "links": [
                  {
                    "href": "http://127.0.0.1:8774/v3/",
                    "rel": "self"
                  }
                ]
              }
            ]
          }
  - name: foo
    request:
      url: "{{baseUrl}}/"
      method: GET
    response:
      status: 300
      statusText: Multiple Choices
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |
          {
           "versions": [
                 {
                   "status": "CURRENT",
                   "updated": "2011-01-21T11:33:21Z",
                   "id": "v2.0",
                   "links": [
                       {
                           "href": "http://127.0.0.1:8774/v2/",
                           "rel": "self"
                       }
                   ]
               },
               {
                   "status": "EXPERIMENTAL",
                   "updated": "2013-07-23T11:33:21Z",
                   "id": "v3.0",
                   "links": [
                       {
                           "href": "http://127.0.0.1:8774/v3/",
                           "rel": "self"
                       }
                   ]
               }
           ]
          }

=== Show API version details.yml
info:
  name: Show API version details
  type: http
  seq: 2

http:
  method: GET
  url: "{{baseUrl}}/v2"
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: foo
    request:
      url: "{{baseUrl}}/v2"
      method: GET
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "version": {
              "status": "CURRENT",
              "updated": "2011-01-21T11:33:21Z",
              "media-types": [
                {
                  "base": "application/xml",
                  "type": "application/vnd.openstack.compute+xml;version=2"
                },
                {
                  "base": "application/json",
                  "type": "application/vnd.openstack.compute+json;version=2"
                }
              ],
              "id": "v2.0",
              "links": [
                {
                  "href": "http://127.0.0.1:8774/v2/",
                  "rel": "self"
                },
                {
                  "href": "http://docs.openstack.org/api/openstack-compute/2/os-compute-devguide-2.pdf",
                  "type": "application/pdf",
                  "rel": "describedby"
                },
                {
                  "href": "http://docs.openstack.org/api/openstack-compute/2/wadl/os-compute-2.wadl",
                  "type": "application/vnd.sun.wadl+xml",
                  "rel": "describedby"
                },
                {
                  "href": "http://docs.openstack.org/api/openstack-compute/2/wadl/os-compute-2.wadl",
                  "type": "application/vnd.sun.wadl+xml",
                  "rel": "describedby"
                }
              ]
            }
          }
  - name: foo
    request:
      url: "{{baseUrl}}/v2"
      method: GET
    response:
      status: 203
      statusText: Non Authoritative Information
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "version": {
              "status": "CURRENT",
              "updated": "2011-01-21T11:33:21Z",
              "media-types": [
                {
                  "base": "application/xml",
                  "type": "application/vnd.openstack.compute+xml;version=2"
                },
                {
                  "base": "application/json",
                  "type": "application/vnd.openstack.compute+json;version=2"
                }
              ],
              "id": "v2.0",
              "links": [
                {
                  "href": "http://23.253.228.211:8774/v2/",
                  "rel": "self"
                },
                {
                  "href": "http://docs.openstack.org/api/openstack-compute/2/os-compute-devguide-2.pdf",
                  "type": "application/pdf",
                  "rel": "describedby"
                },
                {
                  "href": "http://docs.openstack.org/api/openstack-compute/2/wadl/os-compute-2.wadl",
                  "type": "application/vnd.sun.wadl+xml",
                  "rel": "describedby"
                }
              ]
            }
          }

