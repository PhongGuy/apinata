opencollection: 1.0.0

info:
  name: Simple API overview
bundled: false
extensions:
  bruno:
    ignore:
      - node_modules
      - .git
  apinata:
    openapi:
      ops:
        GET /:
          target: 3911b83606f6ea5c
          headers: 7ace431cb61584cb
          body: 7ace431cb61584cb
          docs: 7ace431cb61584cb
          tags: 7ace431cb61584cb
          vars: 7ace431cb61584cb
