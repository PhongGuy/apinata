# Net::HTTP does not follow redirects; this prints the first response.
require "net/http"

uri = URI("http://x.test/i")
request = Net::HTTP::Post.new(uri)
request["X-E"] = "=v"
request["Content-Type"] = "multipart/form-data; boundary=apinata-boundary-5f0c2e9a7d4b"
request.body = [
  "--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n@x\r\n--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name=\"k=v\"\r\n\r\n1\r\n--apinata-boundary-5f0c2e9a7d4b--\r\n".b,
].join

response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == "https") do |http|
  http.request(request)
end
puts response.code
puts response.body
