== Scripted auth header.yml
info:
  name: Scripted auth header
  type: graphql
  seq: 2

graphql:
  method: POST
  url: https://echo.hoppscotch.io/graphql
  headers:
    - name: Authorization
      value: Bearer {{myToken}}
  body:
    query: query AuthEcho { headers { key value } }
    variables: "{}"

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
