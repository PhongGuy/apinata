=== Admin get users.yml
info:
  name: Admin get users
  type: http
  seq: 3

http:
  method: GET
  url: "{{baseUrl}}/admin/users"
  auth:
    type: oauth2
    flow: authorization_code
    authorizationUrl: https://auth.example.com/oauth/authorize
    accessTokenUrl: https://auth.example.com/oauth/token
    credentials:
      clientId: "{{clientId}}"
      clientSecret: "{{clientSecret}}"
      placement: body
    scope: admin
    pkce: {}
    tokenConfig:
      id: credentials
      placement:
        header: Bearer
      source: access_token
    settings:
      autoFetchToken: true
      autoRefreshToken: false

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

docs: Retrieve all users (admin only)

=== Create user.yml
info:
  name: Create user
  type: http
  seq: 2

http:
  method: POST
  url: "{{baseUrl}}/users"
  body:
    type: json
    data: |-
      {
        "name": "",
        "email": ""
      }
  auth:
    type: bearer
    token: "{{token}}"

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

docs: Create a new user

