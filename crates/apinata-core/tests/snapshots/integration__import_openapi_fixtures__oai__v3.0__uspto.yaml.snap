=== environments/Environment 1.yml
name: Environment 1
variables:
  - name: baseUrl
    value: "{{scheme}}://developer.uspto.gov/ds-api"
  - name: scheme
    value: https

=== metadata/List available data sets.yml
info:
  name: List available data sets
  type: http
  seq: 1
  tags:
    - metadata

http:
  method: GET
  url: "{{baseUrl}}/"
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: 200 Response
    description: Returns a list of data sets
    request:
      url: "{{baseUrl}}/"
      method: GET
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "total": 2,
            "apis": [
              {
                "apiKey": "oa_citations",
                "apiVersionNumber": "v1",
                "apiUrl": "https://developer.uspto.gov/ds-api/oa_citations/v1/fields",
                "apiDocumentationUrl": "https://developer.uspto.gov/ds-api-docs/index.html?url=https://developer.uspto.gov/ds-api/swagger/docs/oa_citations.json"
              },
              {
                "apiKey": "cancer_moonshot",
                "apiVersionNumber": "v1",
                "apiUrl": "https://developer.uspto.gov/ds-api/cancer_moonshot/v1/fields",
                "apiDocumentationUrl": "https://developer.uspto.gov/ds-api-docs/index.html?url=https://developer.uspto.gov/ds-api/swagger/docs/cancer_moonshot.json"
              }
            ]
          }

=== metadata/Provides the general information about the API and the list of fields that can be used to query the dataset.yml
info:
  name: Provides the general information about the API and the list of fields that can be used to query the dataset
  type: http
  seq: 2
  tags:
    - metadata

http:
  method: GET
  url: "{{baseUrl}}/:dataset/:version/fields"
  params:
    - name: dataset
      value: oa_citations
      type: path
      description: Name of the dataset.
    - name: version
      value: v1
      type: path
      description: Version of the dataset.
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: 200 Response
    description: The dataset API for the given version is found and it is accessible to consume.
    request:
      url: "{{baseUrl}}/:dataset/:version/fields"
      method: GET
      params:
        - name: dataset
          value: oa_citations
          type: path
          description: Name of the dataset.
        - name: version
          value: v1
          type: path
          description: Version of the dataset.
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: '""'
  - name: 404 Response
    description: The combination of dataset name and version is not found in the system or it is not published yet to be consumed by public.
    request:
      url: "{{baseUrl}}/:dataset/:version/fields"
      method: GET
      params:
        - name: dataset
          value: oa_citations
          type: path
          description: Name of the dataset.
        - name: version
          value: v1
          type: path
          description: Version of the dataset.
    response:
      status: 404
      statusText: Not Found
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: '""'

docs: This GET API returns the list of all the searchable field names that are in the oa_citations. Please see the 'fields' attribute which returns an array of field names. Each field or a combination of fields can be searched using the syntax options shown below.

