<?php

$curl = curl_init();
curl_setopt_array($curl, [
    CURLOPT_URL => "http://x.test/i",
    CURLOPT_CUSTOMREQUEST => "POST",
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_HTTPHEADER => [
        "X-E: =v",
    ],
    CURLOPT_POSTFIELDS => [
        "a" => "@x",
        "k=v" => "1",
    ],
]);

$response = curl_exec($curl);
echo curl_getinfo($curl, CURLINFO_RESPONSE_CODE), "\n";
echo $response, "\n";
