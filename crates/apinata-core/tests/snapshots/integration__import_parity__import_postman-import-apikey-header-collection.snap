== Headers with API Key.yml
info:
  name: Headers with API Key
  type: http
  seq: 1

http:
  method: GET
  url: https://api.com/users?X-API-KEY=12345
  params:
    - name: X-API-KEY
      value: "12345"
      type: query
  auth:
    type: apikey
    key: hii
    value: "{{headers_with_api_key_api_key}}"
    placement: header

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
