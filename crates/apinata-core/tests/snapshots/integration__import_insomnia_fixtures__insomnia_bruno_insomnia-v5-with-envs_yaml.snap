# Test API Collection v5 with Environments
== API Tests/Get Users.yml
info:
  name: Get Users
  type: http
  seq: 1

http:
  method: GET
  url: "{{base_url}}/api/users"
  headers:
    - name: Authorization
      value: Bearer {{auth_token}}
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
