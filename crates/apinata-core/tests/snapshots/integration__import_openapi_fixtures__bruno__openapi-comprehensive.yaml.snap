=== environments/Development server.yml
name: Development server
variables:
  - name: baseUrl
    value: http://localhost:3000/v1
  - secret: true
    name: token

=== environments/Production server.yml
name: Production server
variables:
  - name: baseUrl
    value: https://api.example.com/v1
  - secret: true
    name: token

=== environments/Staging server.yml
name: Staging server
variables:
  - name: baseUrl
    value: https://staging-api.example.com/v1
  - secret: true
    name: token

