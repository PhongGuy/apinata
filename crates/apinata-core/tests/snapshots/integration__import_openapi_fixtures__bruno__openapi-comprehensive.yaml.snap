=== Users/Get all users.yml
info:
  name: Get all users
  type: http
  seq: 1
  tags:
    - Users

http:
  method: GET
  url: "{{baseUrl}}/users?page=1&limit=20"
  params:
    - name: page
      value: "1"
      type: query
      description: Page number for pagination
    - name: limit
      value: "20"
      type: query
      description: Number of items per page
    - name: filter
      value: ""
      type: query
      description: Filter users by name or email
      disabled: true
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: 200 Response
    description: List of users retrieved successfully
    request:
      url: "{{baseUrl}}/users?page=1&limit=20"
      method: GET
      params:
        - name: page
          value: "1"
          type: query
          description: Page number for pagination
        - name: limit
          value: "20"
          type: query
          description: Number of items per page
        - name: filter
          value: ""
          type: query
          description: Filter users by name or email
          disabled: true
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "users": [
              {
                "id": "",
                "email": "",
                "name": "",
                "avatar": "",
                "createdAt": "",
                "updatedAt": ""
              }
            ],
            "pagination": {
              "page": 0,
              "limit": 0,
              "total": 0,
              "totalPages": 0
            }
          }
  - name: 400 Response
    description: Bad request
    request:
      url: "{{baseUrl}}/users?page=1&limit=20"
      method: GET
      params:
        - name: page
          value: "1"
          type: query
          description: Page number for pagination
        - name: limit
          value: "20"
          type: query
          description: Number of items per page
        - name: filter
          value: ""
          type: query
          description: Filter users by name or email
          disabled: true
    response:
      status: 400
      statusText: Bad Request
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "error": "",
            "message": "",
            "code": 0
          }
  - name: 401 Response
    description: Unauthorized
    request:
      url: "{{baseUrl}}/users?page=1&limit=20"
      method: GET
      params:
        - name: page
          value: "1"
          type: query
          description: Page number for pagination
        - name: limit
          value: "20"
          type: query
          description: Number of items per page
        - name: filter
          value: ""
          type: query
          description: Filter users by name or email
          disabled: true
    response:
