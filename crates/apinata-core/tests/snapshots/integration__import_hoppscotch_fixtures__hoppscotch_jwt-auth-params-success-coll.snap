      value: "{{privateKey}}"
    headers: "{{jwtHeaders}}"
    payload: "{{payload}}"
    placement: query
    headerPrefix: Bearer
    queryParamKey: "{{paramName}}"

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
