// AWS Signature auth is not included in this snippet.
import axios from 'axios';

const url = 'http://x.test/aws';
const headers = {};

const response = await axios.request({
  method: 'GET',
  url,
  headers,
  transformRequest: (d) => d,
  transformResponse: (r) => r,
  validateStatus: () => true,
});
console.log(response.status);
