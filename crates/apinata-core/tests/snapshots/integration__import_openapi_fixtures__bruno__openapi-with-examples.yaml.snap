=== Create a new user.yml
info:
  name: Create a new user
  type: http
  seq: 2

http:
  method: POST
  url: "{{baseUrl}}/users"
  body:
    type: json
    data: |-
      {
        "name": "John Doe",
        "email": "john@example.com"
      }
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: User Created
    description: Successfully created user
    request:
      url: "{{baseUrl}}/users"
      method: POST
      body:
        type: json
        data: |-
          {
            "name": "John Doe",
            "email": "john@example.com"
          }
    response:
      status: 201
      statusText: Created
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "id": 123,
            "name": "John Doe",
            "email": "john@example.com",
            "created_at": "2023-01-01T00:00:00Z"
          }
  - name: Validation Error
    description: Invalid user data
    request:
      url: "{{baseUrl}}/users"
      method: POST
      body:
        type: json
        data: |-
          {
            "name": "John Doe",
            "email": "john@example.com"
          }
    response:
      status: 400
      statusText: Bad Request
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "error": "Validation failed",
            "message": "Name and email are required",
            "code": "VALIDATION_ERROR"
          }

=== Get all users.yml
info:
  name: Get all users
  type: http
  seq: 1

http:
  method: GET
  url: "{{baseUrl}}/users"
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: Success Response
    description: A successful response with user data
    request:
      url: "{{baseUrl}}/users"
      method: GET
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "users": [
              {
                "id": 1,
                "name": "John Doe",
                "email": "john@example.com"
              },
              {
                "id": 2,
                "name": "Jane Smith",
                "email": "jane@example.com"
              }
            ]
          }
  - name: Empty Response
    description: No users found
    request:
      url: "{{baseUrl}}/users"
      method: GET
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "users": []
          }
  - name: Validation Error
    description: Invalid request parameters
    request:
      url: "{{baseUrl}}/users"
      method: GET
    response:
      status: 400
      statusText: Bad Request
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "error": "Invalid parameters",
            "message": "The request contains invalid data",
            "code": "VALIDATION_ERROR"
          }
  - name: Server Error
    description: Internal server error occurred
    request:
      url: "{{baseUrl}}/users"
      method: GET
    response:
      status: 500
      statusText: Internal Server Error
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "error": "Internal Server Error",
            "message": "Something went wrong on our end",
            "code": "INTERNAL_ERROR"
          }

=== Get user by ID.yml
info:
  name: Get user by ID
  type: http
  seq: 3

http:
  method: GET
  url: "{{baseUrl}}/users/:id"
  params:
    - name: id
      value: "123"
      type: path
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: User Found
    description: User successfully retrieved
    request:
      url: "{{baseUrl}}/users/:id"
      method: GET
      params:
        - name: id
          value: "123"
          type: path
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "id": 123,
            "name": "John Doe",
            "email": "john@example.com",
            "created_at": "2023-01-01T00:00:00Z"
          }
  - name: User Not Found
    description: User with the specified ID does not exist
    request:
      url: "{{baseUrl}}/users/:id"
      method: GET
      params:
        - name: id
          value: "123"
          type: path
    response:
      status: 404
      statusText: Not Found
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "error": "Not Found",
            "message": "User with ID 123 not found",
            "code": "USER_NOT_FOUND"
          }

