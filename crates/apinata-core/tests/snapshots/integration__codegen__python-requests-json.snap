import requests

url = 'http://x.test/j'
headers = {
    'content-type': 'application/json',
}
data = '{"a": 1, "s": "x y"}'.encode('utf-8')

response = requests.request('POST', url, headers=headers, data=data)
print(response.status_code)
print(response.text)
