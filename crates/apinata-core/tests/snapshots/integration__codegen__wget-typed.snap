---
source: crates/apinata-core/tests/codegen.rs
expression: "generate(&typed(), target)"
---
body=$(mktemp)
{
  printf '%b' '--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="j"\r\nContent-Type: application/json\r\n\r\n{"a": "x﻿y"}\r\n--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="t"\r\n\r\nplain\r\n--apinata-boundary-5f0c2e9a7d4b--\r\n'
} > "$body"
wget --quiet --output-document=- --content-on-error --method='POST' \
  --header='Content-Type: multipart/form-data; boundary=apinata-boundary-5f0c2e9a7d4b' \
  --body-file="$body" \
  'http://x.test/t'
rm -f "$body"
