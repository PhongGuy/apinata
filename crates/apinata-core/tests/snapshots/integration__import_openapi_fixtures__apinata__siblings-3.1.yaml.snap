=== Add pet.yml
info:
  name: Add pet
  type: http
  seq: 2

http:
  method: POST
  url: "{{baseUrl}}/pets"
  body:
    type: json
    data: |-
      {
        "nickname": "rex"
      }
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

=== Get pet.yml
info:
  name: Get pet
  type: http
  seq: 1

http:
  method: GET
  url: "{{baseUrl}}/pets/:id"
  params:
    - name: id
      value: ""
      type: path
      description: The pet to fetch
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

