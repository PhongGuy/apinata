{
  "info": {
    "name": "bruno-yml-testbench",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "response-time",
      "item": [
        {
          "name": "delayed headers",
          "protocolProfileBehavior": {
            "followAuthorizationHeader": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "url": {
              "raw": "{{localhost}}/api/wait-for/headers?time=1000",
              "protocol": "",
              "host": [
                "{{localhost}}"
              ],
              "path": [
                "api",
                "wait-for",
                "headers"
              ],
              "query": [
                {
                  "key": "time",
                  "value": "1000"
                }
              ],
              "variable": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "// Tests",
                  "const WAIT_MS = 1000;",
                  "// The server's timer can fire a few ms before `time` has elapsed by the client's clock.",
                  "const TIMER_SLACK_MS = 50;",
                  "",
                  "test(\"response time covers the full wait when headers are held back\", () => {",
                  "  expect(pm.response.responseTime).to.be.at.least(WAIT_MS - TIMER_SLACK_MS);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "delayed body",
          "protocolProfileBehavior": {
            "followAuthorizationHeader": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "url": {
              "raw": "{{localhost}}/api/wait-for/body?time=1000",
              "protocol": "",
              "host": [
                "{{localhost}}"
              ],
              "path": [
                "api",
                "wait-for",
                "body"
              ],
              "query": [
                {
                  "key": "time",
                  "value": "1000"
                }
              ],
              "variable": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "// Tests",
                  "const WAIT_MS = 1000;",
                  "// The server's timer can fire a few ms before `time` has elapsed by the client's clock.",
                  "const TIMER_SLACK_MS = 50;",
                  "",
                  "test(\"response time covers the full wait when the body streams slowly after immediate headers\", () => {",
                  "  expect(pm.response.responseTime).to.be.at.least(WAIT_MS - TIMER_SLACK_MS);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "variable-datatypes",
      "item": [
        {
          "name": "typed vars",
          "protocolProfileBehavior": {
            "followAuthorizationHeader": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-h-str",
                "value": "{{req_str}}",
                "description": "",
                "disabled": false,
                "type": "default"
              },
              {
                "key": "x-h-num",
                "value": "{{req_num}}",
                "description": "",
                "disabled": false,
                "type": "default"
              },
              {
                "key": "x-h-bool",
                "value": "{{req_bool}}",
                "description": "",
                "disabled": false,
                "type": "default"
              },
              {
                "key": "x-h-obj",
                "value": "{{req_obj}}",
                "description": "",
                "disabled": false,
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "url": {
              "raw": "{{echo-host}}",
              "protocol": "",
              "host": [
                "{{echo-host}}"
              ],
              "path": [],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coll_num\": {{coll_num}},\n  \"coll_bool\": {{coll_bool}},\n  \"coll_obj\": {{coll_obj}},\n  \"fold_num\": {{fold_num}},\n  \"fold_bool\": {{fold_bool}},\n  \"fold_obj\": {{fold_obj}},\n  \"req_num\": {{req_num}},\n  \"req_bool\": {{req_bool}},\n  \"req_obj\": {{req_obj}},\n  \"req_obj_precision\": {{req_obj_precision}},\n  \"req_obj_empty\": {{req_obj_empty}},\n  \"typed_env_num\": {{typed_env_num}},\n  \"typed_env_bool\": {{typed_env_bool}},\n  \"typed_env_obj\": {{typed_env_obj}},\n  \"runtime_num\": {{runtime_num}},\n  \"runtime_bool\": {{runtime_bool}},\n  \"runtime_obj\": {{runtime_obj}},\n  \"inferred_env_num\": {{inferred_env_num}},\n  \"inferred_env_bool\": {{inferred_env_bool}},\n  \"inferred_env_obj\": {{inferred_env_obj}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "pm.variables.set(\"runtime_str\", \"runtime_string\");",
                  "pm.variables.set(\"runtime_num\", 999);",
                  "pm.variables.set(\"runtime_bool\", true);",
                  "pm.variables.set(\"runtime_obj\", { nested: \"yes\" });",
                  "",
                  "pm.environment.set(\"inferred_env_num\", 700);",
                  "pm.environment.set(\"inferred_env_bool\", true);",
                  "pm.environment.set(\"inferred_env_obj\", { from: \"script\" });",
                  "",
                  "pm.environment.set(\"strict_num_str\", \"42\");",
                  "pm.environment.set(\"strict_bool_str\", \"true\");",
                  "pm.environment.set(\"strict_obj_str\", JSON.stringify({ k: 1 }));",
                  "pm.variables.set(\"strict_runtime_num_str\", \"42\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "// Tests",
                  "test(\"collection vars carry their declared types\", () => {",
                  "  expect(typeof pm.collectionVariables.get(\"coll_str\")).to.equal(\"string\");",
                  "  expect(typeof pm.collectionVariables.get(\"coll_num\")).to.equal(\"number\");",
                  "  expect(pm.collectionVariables.get(\"coll_num\")).to.equal(100);",
                  "  expect(typeof pm.collectionVariables.get(\"coll_bool\")).to.equal(\"boolean\");",
                  "  expect(pm.collectionVariables.get(\"coll_bool\")).to.equal(false);",
                  "  expect(pm.collectionVariables.get(\"coll_obj\")).to.deep.equal({ scope: \"collection\" });",
                  "});",
                  "",
                  "test(\"folder vars carry their declared types\", () => {",
                  "  expect(typeof pm.variables.get(\"fold_str\")).to.equal(\"string\");",
                  "  expect(typeof pm.variables.get(\"fold_num\")).to.equal(\"number\");",
                  "  expect(pm.variables.get(\"fold_num\")).to.equal(200);",
                  "  expect(typeof pm.variables.get(\"fold_bool\")).to.equal(\"boolean\");",
                  "  expect(pm.variables.get(\"fold_bool\")).to.equal(true);",
                  "  expect(pm.variables.get(\"fold_obj\")).to.deep.equal({ scope: \"folder\" });",
                  "});",
                  "",
                  "test(\"request vars carry their declared types\", () => {",
                  "  expect(typeof pm.variables.get(\"req_str\")).to.equal(\"string\");",
                  "  expect(typeof pm.variables.get(\"req_num\")).to.equal(\"number\");",
                  "  expect(pm.variables.get(\"req_num\")).to.equal(42);",
                  "  expect(typeof pm.variables.get(\"req_bool\")).to.equal(\"boolean\");",
                  "  expect(pm.variables.get(\"req_bool\")).to.equal(true);",
                  "  expect(pm.variables.get(\"req_obj\")).to.deep.equal({ key: \"value\" });",
                  "",
                  "  expect(typeof pm.variables.get(\"req_obj_empty\")).to.equal(\"object\");",
                  "  expect(pm.variables.get(\"req_obj_empty\")).to.deep.equal({});",
                  "",
                  "  // @number with non-numeric data falls through to the raw string —",
                  "  // same signal the env editor uses to surface its warning icon.",
                  "  expect(typeof pm.variables.get(\"mismatched_num\")).to.equal(\"string\");",
                  "  expect(pm.variables.get(\"mismatched_num\")).to.equal(\"not-a-number\");",
                  "});",
                  "",
                  "test(\"typed object var preserves number precision through file → parse round-trip\", () => {",
                  "  const v = pm.variables.get(\"req_obj_precision\");",
                  "  expect(v.integer).to.equal(123);",
                  "  expect(v.negativeInteger).to.equal(-99);",
                  "  expect(v.zero).to.equal(0);",
                  "  expect(v.float).to.equal(2.718);",
                  "  expect(v.negativeFloat).to.equal(-1.618);",
                  "  expect(v.largeDouble).to.equal(12345.678901234567);",
                  "  expect(v.smallDouble).to.equal(9.876e-12);",
                  "  expect(v.booleanTrue).to.equal(true);",
                  "  expect(v.booleanFalse).to.equal(false);",
                  "});",
                  "",
                  "test(\"collection environment vars carry their declared types\", () => {",
                  "  expect(typeof pm.environment.get(\"typed_env_num\")).to.equal(\"number\");",
                  "  expect(pm.environment.get(\"typed_env_num\")).to.equal(300);",
                  "  expect(typeof pm.environment.get(\"typed_env_bool\")).to.equal(\"boolean\");",
                  "  expect(pm.environment.get(\"typed_env_bool\")).to.equal(true);",
                  "  expect(pm.environment.get(\"typed_env_obj\")).to.deep.equal({ scope: \"env\" });",
                  "});",
                  "",
                  "test(\"runtime vars set via bru.setVar preserve types\", () => {",
                  "  expect(typeof pm.variables.get(\"runtime_str\")).to.equal(\"string\");",
                  "  expect(typeof pm.variables.get(\"runtime_num\")).to.equal(\"number\");",
                  "  expect(pm.variables.get(\"runtime_num\")).to.equal(999);",
                  "  expect(typeof pm.variables.get(\"runtime_bool\")).to.equal(\"boolean\");",
                  "  expect(pm.variables.get(\"runtime_obj\")).to.deep.equal({ nested: \"yes\" });",
                  "});",
                  "",
                  "test(\"setEnvVar infers dataType from the JS value\", () => {",
                  "  expect(typeof pm.environment.get(\"inferred_env_num\")).to.equal(\"number\");",
                  "  expect(pm.environment.get(\"inferred_env_num\")).to.equal(700);",
                  "  expect(typeof pm.environment.get(\"inferred_env_bool\")).to.equal(\"boolean\");",
                  "  expect(pm.environment.get(\"inferred_env_bool\")).to.equal(true);",
                  "  expect(pm.environment.get(\"inferred_env_obj\")).to.deep.equal({ from: \"script\" });",
                  "});",
                  "",
                  "test(\"bru.set* identifies type via the value's runtime type, not string content\", () => {",
                  "  expect(typeof pm.environment.get(\"strict_num_str\")).to.equal(\"string\");",
                  "  expect(pm.environment.get(\"strict_num_str\")).to.equal(\"42\");",
                  "  expect(typeof pm.environment.get(\"strict_bool_str\")).to.equal(\"string\");",
                  "  expect(pm.environment.get(\"strict_bool_str\")).to.equal(\"true\");",
                  "  expect(typeof pm.environment.get(\"strict_obj_str\")).to.equal(\"string\");",
                  "  expect(pm.environment.get(\"strict_obj_str\")).to.equal('{\"k\":1}');",
                  "  expect(typeof pm.variables.get(\"strict_runtime_num_str\")).to.equal(\"string\");",
                  "});",
                  "",
                  "test(\"response body echoes typed values from every scope\", () => {",
                  "  const json = pm.response.json();",
                  "  expect(json.coll_num).to.equal(100);",
                  "  expect(json.coll_bool).to.equal(false);",
                  "  expect(json.coll_obj).to.deep.equal({ scope: \"collection\" });",
                  "  expect(json.fold_num).to.equal(200);",
                  "  expect(json.fold_bool).to.equal(true);",
                  "  expect(json.fold_obj).to.deep.equal({ scope: \"folder\" });",
                  "  expect(json.req_num).to.equal(42);",
                  "  expect(json.req_bool).to.equal(true);",
                  "  expect(json.req_obj).to.deep.equal({ key: \"value\" });",
                  "",
                  "  expect(json.req_obj_precision.integer).to.equal(123);",
                  "  expect(json.req_obj_precision.negativeInteger).to.equal(-99);",
                  "  expect(json.req_obj_precision.zero).to.equal(0);",
                  "  expect(json.req_obj_precision.float).to.equal(2.718);",
                  "  expect(json.req_obj_precision.negativeFloat).to.equal(-1.618);",
                  "  expect(json.req_obj_precision.largeDouble).to.equal(12345.678901234567);",
                  "  expect(json.req_obj_precision.smallDouble).to.equal(9.876e-12);",
                  "  expect(json.req_obj_precision.booleanTrue).to.equal(true);",
                  "  expect(json.req_obj_precision.booleanFalse).to.equal(false);",
                  "  expect(json.req_obj_empty).to.deep.equal({});",
                  "",
                  "  expect(json.typed_env_num).to.equal(300);",
                  "  expect(json.typed_env_bool).to.equal(true);",
                  "  expect(json.typed_env_obj).to.deep.equal({ scope: \"env\" });",
                  "  expect(json.runtime_num).to.equal(999);",
                  "  expect(json.runtime_bool).to.equal(true);",
                  "  expect(json.runtime_obj).to.deep.equal({ nested: \"yes\" });",
                  "  expect(json.inferred_env_num).to.equal(700);",
                  "  expect(json.inferred_env_bool).to.equal(true);",
                  "  expect(json.inferred_env_obj).to.deep.equal({ from: \"script\" });",
                  "});",
                  "",
                  "test(\"typed vars in request headers stringify on the wire\", () => {",
                  "  // echo-host reflects request headers as response headers (lowercased).",
                  "  const headers = pm.response.headers;",
                  "  expect(headers[\"x-h-str\"]).to.equal(\"request_string\");",
                  "  expect(headers[\"x-h-num\"]).to.equal(\"42\");",
                  "  expect(headers[\"x-h-bool\"]).to.equal(\"true\");",
                  "  expect(headers[\"x-h-obj\"]).to.equal('{\"key\":\"value\"}');",
                  "});"
                ]
              }
            }
          ]
        },
