=== Return status code.yml
info:
  name: Return status code
  type: http
  seq: 3

http:
  method: GET
  url: "{{baseUrl}}/status/:code"
  params:
    - name: code
      value: "100"
      type: path
      description: HTTP status code to return
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

docs: Return a specific HTTP status code

