=== Get data.yml
info:
  name: Get data
  type: http
  seq: 3

http:
  method: GET
  url: "{{baseUrl}}/data?limit=10"
  params:
    - name: limit
      value: "10"
      type: query
      description: Maximum number of items to return
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: 200 Response
    description: Successful response
    request:
      url: "{{baseUrl}}/data?limit=10"
      method: GET
      params:
        - name: limit
          value: "10"
          type: query
          description: Maximum number of items to return
    response:
      status: 200
      statusText: OK
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          [
            {
              "id": 0,
              "name": "",
              "description": ""
            }
          ]

docs: Retrieve data from the API

