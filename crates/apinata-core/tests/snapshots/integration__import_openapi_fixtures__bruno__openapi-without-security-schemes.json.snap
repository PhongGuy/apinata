=== Create data.yml
info:
  name: Create data
  type: http
  seq: 4

http:
  method: POST
  url: "{{baseUrl}}/data"
  body:
    type: json
    data: |-
      {
        "name": "",
        "description": ""
      }
  auth: inherit

settings:
  encodeUrl: true
  timeout: inherit
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false

examples:
  - name: 201 Response
    description: Data created successfully
    request:
      url: "{{baseUrl}}/data"
      method: POST
      body:
        type: json
        data: |-
          {
            "name": "",
            "description": ""
          }
    response:
      status: 201
      statusText: Created
      headers:
        - name: Content-Type
          value: application/json
      body:
        type: json
        data: |-
          {
            "id": 0,
            "name": "",
            "description": "",
            "created_at": ""
          }

docs: Create new data item

