source: crates/apinata-core/tests/codegen.rs
expression: out
---
package main

import (
	"bytes"
	"fmt"
	"io"
	"mime/multipart"
	"net/http"
	"net/textproto"
)

func main() {
	url := "http://x.test/t"
	body := &bytes.Buffer{}
	form := multipart.NewWriter(body)
	header := make(textproto.MIMEHeader)
	header.Set("Content-Disposition", "form-data; name=\"j\"")
	header.Set("Content-Type", "application/json")
	part, err := form.CreatePart(header)
	if err != nil {
		panic(err)
	}
	if _, err := io.WriteString(part, "{\"a\": \"x\ufeffy\"}"); err != nil {
		panic(err)
	}
	if err := form.WriteField("t", "plain"); err != nil {
		panic(err)
	}
	if err := form.Close(); err != nil {
		panic(err)
	}
	req, err := http.NewRequest("POST", url, body)
	if err != nil {
		panic(err)
	}
	req.Header.Set("Content-Type", form.FormDataContentType())

	res, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer res.Body.Close()
	out, err := io.ReadAll(res.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(res.Status)
	fmt.Println(string(out))
}
