import fs from 'node:fs';

const url = 'http://x.test/x';
const headers = {
  'Content-Type': 'multipart/form-data; boundary=apinata-boundary-5f0c2e9a7d4b',
};
const body = Buffer.concat([
  Buffer.from('--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="j"\r\nContent-Type: application/json\r\n\r\n{"a": 1}\r\n--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="q%22x"\r\n\r\nplain\r\n--apinata-boundary-5f0c2e9a7d4b\r\nContent-Disposition: form-data; name="up"; filename="up.bin"\r\nContent-Type: text/plain\r\n\r\n'),
  fs.readFileSync('/data/up.bin'),
  Buffer.from('\r\n--apinata-boundary-5f0c2e9a7d4b--\r\n'),
]);

const response = await fetch(url, { method: 'POST', headers, body });
console.log(response.status);
console.log(await response.text());
