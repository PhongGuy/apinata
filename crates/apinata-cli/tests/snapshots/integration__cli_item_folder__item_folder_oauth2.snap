== users/
== users/folder.yml
info:
  name: users
  type: folder
  seq: 1

request:
  headers:
    - name: X-A
      value: "1"
  variables:
    - name: host
      value: localhost
    - name: n
      value:
        type: number
        data: "1"
  auth:
    type: oauth2
    flow: authorization_code
    authorizationUrl: https://id.test/authorize
    accessTokenUrl: https://id.test/token
    callbackUrl: http://localhost:8765/cb
    credentials:
      clientId: app
      clientSecret: "{{client_secret}}"
      placement: basic_auth_header
    additionalParameters:
      authorizationRequest:
        - name: audience
          placement: query
          value: api
    scope: read write
    pkce: {}
    tokenConfig:
      id: main
      placement:
        query: access_token
      source: access_token
    settings:
      autoFetchToken: true
      autoRefreshToken: true

docs: notes
== users/get.yml
info:
  name: get
  type: http
  seq: 1
http:
  method: GET
  url: http://localhost/u
